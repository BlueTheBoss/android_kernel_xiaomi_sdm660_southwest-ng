# Platform
CONFIG_MACH_XIAOMI_TULIP=y

# Camera
CONFIG_MSMB_CAMERA_LEGACY=y

# Hall sensor
CONFIG_INPUT_HALL_SENSOR_E7S=y

# Touchscreen
CONFIG_TOUCHSCREEN_NVT_A=y
CONFIG_TOUCHSCREEN_FOCAL_FT8719_E7T=y

# Haptics
CONFIG_INPUT_QTI_HAPTICS=y

# Audio (Smart PA TAS2555/TAS2557)
CONFIG_SND_SOC_TAS2557=y
CONFIG_TAS2557_CODEC=y
CONFIG_TAS2557_MISC=y
CONFIG_TAS2557_REGMAP=y

# Scheduler & Memory Optimizations
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set

# Network Optimizations (TCP BBR + CAKE)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# FUSE BPF Passthrough (Reduce app storage overhead)
CONFIG_FUSE_BPF=y

# BPF JIT (Faster BPF packet filtering & security hooks)
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
