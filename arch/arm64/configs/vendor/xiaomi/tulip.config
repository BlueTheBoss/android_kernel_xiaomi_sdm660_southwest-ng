# Platform
CONFIG_MACH_XIAOMI_TULIP=y

# Camera
CONFIG_MSMB_CAMERA_LEGACY=y

# Hall sensor
CONFIG_INPUT_HALL_SENSOR_E7S=y

# Touchscreen
CONFIG_TOUCHSCREEN_NVT_A=y
CONFIG_TOUCHSCREEN_FOCAL_FT8719_E7T=y

# Haptics
CONFIG_INPUT_QTI_HAPTICS=y

# Audio (Smart PA TAS2555/TAS2557)
CONFIG_SND_SOC_TAS2557=y
CONFIG_TAS2557_CODEC=y
CONFIG_TAS2557_MISC=y
CONFIG_TAS2557_REGMAP=y

# KernelSU-Next Manual Hook Mode
CONFIG_MODULES=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_HAVE_KRETPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y


# --- Performance Optimizations ---
# 1. Disable Extensive Kernel Debugging
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_INFO is not set

# 2. Upgrade TCP Congestion Control
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_TCP_CONG_WESTWOOD=y

# 3. Flash-Optimized I/O Scheduler
CONFIG_IOSCHED_ZEN=y
CONFIG_DEFAULT_ZEN=y
CONFIG_IOSCHED_MAPLE=y
CONFIG_IOSCHED_FIOPS=y
\n
# 4. Upgrade ZRAM Compression to ZSTD
CONFIG_ZRAM=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
